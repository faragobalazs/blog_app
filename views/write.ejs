<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Web App</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&family=Passion+One:wght@400;700;900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="pictures/icon.png" type="x-icon" />
    <link rel="stylesheet" href="../styles/styles.css" />
  </head>
  <body>
    <div class="container">
      <div class="heads passion-one-regular">
        Capstone Project | Web Blog Application
      </div>
      <div class="blog">
        <div class="button-row">
          <div class="button-space"></div>
          <div class="button-space">
            <a href="/"><button class="btn">Home</button></a>
          </div>
          <div class="button-space">
            <a href="/posts.ejs"><button class="btn">Posts</button></a>
          </div>
          <div class="button-space">
            <a href="/write.ejs"><button class="btn">Write</button></a>
          </div>
          <div class="button-space">
            <a href="https://github.com/faragobalazs"
              ><button class="btn">Github</button></a
            >
          </div>
        </div>
        <!----->
        <div class="blog-container">
          <div class="text-title"></div>
          <div class="text-container">
            <form action="/submit" method="POST">
              <br />
              <label for="post-title">Post Title:</label><br />
              <input
                type="text"
                id="post-title"
                name="post-title"
              /><br /><br />
              <label for="post-content">Post Content:</label><br />
              <textarea
                type="text"
                id="post-content"
                name="post-content"
                rows="5"
                cols="22"
              ></textarea
              ><br /><br />
              <button type="submit" id="post-submit" class="submit-btn">
                Publish
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <div class="foot passion-one-regular">
      Balázs Faragó © <%= new Date().getFullYear() %>
    </div>
    <script>
      const buttonsToFlash = document.querySelectorAll(".button-row .btn");

      buttonsToFlash.forEach((button) => {
        button.addEventListener("click", function (event) {
          this.classList.add("btn-flashing");
        });
      });
    </script>
  </body>
</html>
